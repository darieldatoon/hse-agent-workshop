# Copy to .env and fill in.
# On Colab, LANGSMITH_API_KEY goes in the 🔑 Secrets panel instead, with "Notebook access" on.

# Participants: the workshop key from your instructor.
# Instructor: an org admin key, for Terraform (infra/) and the seeder (seed/).
LANGSMITH_API_KEY=

# Participants running locally: your workspace ID, or type your workspace name into the
# notebook's WORKSPACE field instead.
# LANGSMITH_WORKSPACE_ID=

# Optional. A separate key for the model gateway; unset, model calls use LANGSMITH_API_KEY.
# LANGSMITH_GATEWAY_API_KEY=
