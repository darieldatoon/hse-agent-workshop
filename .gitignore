infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/attendees.csv
infra/crash.log

# Seeder output: traces captured from the v0 agent before replay
seed/.cache/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
